# HepatoGuard Environment Configuration Example
PORT=5050

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# The key format should start with "AIzaSy..."
# If not provided, HepatoGuard automatically uses its built-in Precision Oncology Reasoning Engine.
GEMINI_API_KEY=AIzaSyYourGoogleAiStudioKeyHere
